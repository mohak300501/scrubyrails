      </h2>

      <div class="pragya-modal-meta">
        <% if event.date.present? %>
          <div class="pragya-modal-meta-item"><span>📅</span><span><%= event.date %></span></div>
        <% elsif event.day.present? %>
          <div class="pragya-modal-meta-item"><span>📅</span><span>Day <%= event.day %></span></div>
        <% end %>
        <% if event.time.present? %>
          <div class="pragya-modal-meta-item"><span>🕐</span><span><%= event.time %></span></div>
        <% end %>
        <% if event.venue.present? %>
          <div class="pragya-modal-meta-item"><span>📍</span><span><%= event.venue %></span></div>
        <% end %>
        <% if event.team_size.present? %>
          <div class="pragya-modal-meta-item"><span>👥</span><span><%= event.team_size %></span></div>
        <% end %>
        <% if event.eligibility.present? %>
          <div class="pragya-modal-meta-item"><span>✅</span><span><%= event.eligibility %></span></div>
        <% end %>
        <% if event.prize.present? %>
          <div class="pragya-modal-meta-item"><span>🏆</span><span><%= event.prize %></span></div>
        <% end %>
      </div>

      <div class="pragya-modal-desc">
        <%= simple_format(event.description) %>
