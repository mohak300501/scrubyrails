      <%# Filter tabs %>
      <div class="pragya-filter-tabs">
        <button class="pragya-ftab active" onclick="pragyaFilter(this,'all')">All</button>
        <button class="pragya-ftab" onclick="pragyaFilter(this,'competition')">Competition</button>
        <button class="pragya-ftab" onclick="pragyaFilter(this,'workshop')">Workshop</button>
        <button class="pragya-ftab" onclick="pragyaFilter(this,'cultural')">Cultural</button>
        <button class="pragya-ftab" onclick="pragyaFilter(this,'lecture')">Lecture</button>
      </div>

      <%# Day wise schedule — loops over whatever days exist in DB %>
      <% @events_by_day.keys.sort.each do |day| %>
        <% day_events = @events_by_day[day] %>
        <% next if day_events.blank? %>

        <div class="pragya-day-block">
          <div class="pragya-day-label">
            <span class="pragya-day-num">Day <%= day %></span>
          </div>

          <div class="pragya-events-grid">
            <% day_events.each do |event| %>

              <div class="pragya-event-card" data-cat="<%= event.category.to_s.downcase %>">

  <%# Poster — full image no crop %>
  <div class="pragya-event-thumb-wrap">
    <% if event.poster_image.attached? %>
      <img src="<%= url_for(event.poster_image) %>"
           alt="<%= event.title %>"
           class="pragya-poster-img">
    <% else %>
      <div class="pragya-event-thumb pec-<%= event.category.to_s.downcase %>">
        <%= category_emoji(event.category) %>
      </div>
    <% end %>
    <% if event.status.present? %>
      <span class="pragya-ebadge peb-<%= event.status %>">
        <%= event.status.gsub('_', ' ').titleize %>
      </span>
    <% end %>
  </div>

  <%# Body %>
  <div class="pragya-event-body">
    <% if event.category.present? %>
      <div class="pragya-event-cat"><%= event.category.capitalize %></div>
    <% end %>
    <h3>
      <%= event.title %>
      <% if event.title_sanskrit.present? %>
        <span class="pragya-event-sanskrit">· <%= event.title_sanskrit %></span>
      <% end %>
    </h3>
    <div class="pragya-event-desc">
      <%= simple_format(truncate(event.description, length: 150)) %>
    </div>
  </div>

  <%# Footer %>
  <div class="pragya-event-footer">
    <a href="#" class="pragya-read-more-btn"
       onclick="pragyaOpenModal(<%= event.id %>); return false;">
      Read More ↗
    </a>
    <% reg_link = event.registration_link.present? ? event.registration_link : (session[:user] ? sanskritweek_user_n_path : user_login_path) %>
    <%= link_to "Register →", reg_link,
        class: "pragya-event-cta",
        target: event.registration_link.present? ? "_blank" : nil %>
  </div>

</div>

<%# Modal for this event — hidden by default %>
<div class="pragya-modal" id="pragya-modal-<%= event.id %>" style="display:none;">
  <div class="pragya-modal-overlay" onclick="pragyaCloseModal(<%= event.id %>)"></div>
  <div class="pragya-modal-box">

    <button class="pragya-modal-close" onclick="pragyaCloseModal(<%= event.id %>)">✕</button>

    <% if event.poster_image.attached? %>
      <img src="<%= url_for(event.poster_image) %>"
           alt="<%= event.title %>"
           class="pragya-modal-poster">
    <% end %>

    <div class="pragya-modal-body">
      <% if event.category.present? %>
        <div class="pragya-event-cat"><%= event.category.capitalize %></div>
      <% end %>
      <h2 class="pragya-modal-title">
        <%= event.title %>
        <% if event.title_sanskrit.present? %>
          <span class="pragya-event-sanskrit">· <%= event.title_sanskrit %></span>
