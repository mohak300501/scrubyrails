<%# ══════ SCRIPTS ══════ %>
<script>
/* ── EMBER PARTICLES ── */
(function(){
  var canvas = document.getElementById('pragya-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var W, H, particles = [];
  function resize(){
    W = canvas.width  = canvas.offsetWidth;
    H = canvas.height = canvas.offsetHeight;
  }
  window.addEventListener('resize', resize); resize();
  function rand(a,b){ return a+Math.random()*(b-a); }
  function P(){ this.reset(); }
  P.prototype.reset = function(){
    this.x=rand(0,W); this.y=rand(H*0.3,H);
    this.vy=-rand(0.25,1.1); this.vx=rand(-0.18,0.18);
    this.size=rand(1.2,3.2); this.life=rand(0.3,1);
    this.decay=rand(0.0015,0.0045);
    this.isGold=Math.random()>0.35;
  };
  P.prototype.update=function(){
    this.x+=this.vx+Math.sin(this.y*0.012)*0.12;
    this.y+=this.vy; this.life-=this.decay;
    if(this.life<=0||this.y<-10) this.reset();
  };
  P.prototype.draw=function(){
    var a=Math.max(0,this.life);
    ctx.globalAlpha=a*0.75;
    ctx.fillStyle=this.isGold?'#d4a96a':'#c94040';
    ctx.beginPath(); ctx.arc(this.x,this.y,this.size*a,0,Math.PI*2); ctx.fill();
    ctx.globalAlpha=a*0.15;
    ctx.beginPath(); ctx.arc(this.x,this.y,this.size*a*2.5,0,Math.PI*2); ctx.fill();
  };
  for(var i=0;i<110;i++){ var p=new P(); p.y=rand(0,H); particles.push(p); }
  function animate(){
    ctx.clearRect(0,0,W,H);
    particles.forEach(function(p){ p.update(); p.draw(); });
    ctx.globalAlpha=1;
    requestAnimationFrame(animate);
  }
  animate();
})();

/* ── COUNTDOWN ──
   3 states:
   Before Aug 21  → shows countdown timer
   Aug 21–23      → hides timer, shows LIVE banner
   After Aug 23   → hides timer, shows ENDED banner
   ★ Change dates here if needed ★ */
(function(){
  var FEST_START = new Date('2026-08-21T09:00:00');
  var FEST_END   = new Date('2026-08-23T23:59:59');

  function pad(n){ return String(n).padStart(2,'0'); }

  function tick(){
    var now  = new Date();
    var diff = FEST_START - now;

    if (now > FEST_END) {
      document.getElementById('pragya-countdown').style.display = 'none';
      document.getElementById('pragya-live').style.display      = 'none';
      document.getElementById('pragya-ended').style.display     = 'block';
      return;
    }

    if (diff <= 0) {
      document.getElementById('pragya-countdown').style.display = 'none';
      document.getElementById('pragya-live').style.display      = 'block';
      document.getElementById('pragya-ended').style.display     = 'none';
      return;
    }

    document.getElementById('pragya-days').textContent  = pad(Math.floor(diff/86400000));
    document.getElementById('pragya-hours').textContent = pad(Math.floor((diff%86400000)/3600000));
    document.getElementById('pragya-mins').textContent  = pad(Math.floor((diff%3600000)/60000));
    document.getElementById('pragya-secs').textContent  = pad(Math.floor((diff%60000)/1000));
  }

  tick();
  setInterval(tick, 1000);
})();

/* ── EVENT FILTER ── */
function pragyaFilter(btn, cat){
  document.querySelectorAll('.pragya-ftab').forEach(function(t){ t.classList.remove('active'); });
  btn.classList.add('active');
  document.querySelectorAll('.pragya-event-card').forEach(function(card){
    card.style.display=(cat==='all'||card.dataset.cat===cat)?'':'none';
  });
}

/* ── SMOOTH SCROLL ── */
document.querySelectorAll('a[href^="#pragya"]').forEach(function(a){
  a.addEventListener('click',function(e){
    var t=document.querySelector(this.getAttribute('href'));
    if(t){ e.preventDefault(); window.scrollTo({top:t.getBoundingClientRect().top+window.scrollY-80,behavior:'smooth'}); }
  });
});

/* ── READ MORE TOGGLE ── */
/* ── MODAL ── */
/* ── MODAL ── */
function pragyaOpenModal(id) {
  var modal = document.getElementById('pragya-modal-' + id);
  if (!modal) return;
  /* Save current scroll position */
  var scrollY = window.scrollY;
  modal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
  document.body.style.position = 'fixed';
  document.body.style.top = '-' + scrollY + 'px';
  document.body.style.width = '100%';
  document.body.dataset.scrollY = scrollY;
}

function pragyaCloseModal(id) {
  var modal = document.getElementById('pragya-modal-' + id);
  if (!modal) return;
  modal.style.display = 'none';
  /* Restore scroll position exactly where user was */
  var scrollY = parseInt(document.body.dataset.scrollY || '0');
  document.body.style.overflow = '';
  document.body.style.position = '';
  document.body.style.top = '';
  document.body.style.width = '';
  window.scrollTo(0, scrollY);
}

/* Close on Escape key */
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    var scrollY = parseInt(document.body.dataset.scrollY || '0');
    document.querySelectorAll('.pragya-modal').forEach(function(m) {
      m.style.display = 'none';
    });
    document.body.style.overflow = '';
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.width = '';
    window.scrollTo(0, scrollY);
  }
});


/* ── PAST EVENTS YEAR TABS ── */
function pragyaSwitchYear(id, btn) {
  /* Hide all panels */
  document.querySelectorAll('.pragya-past-panel').forEach(function(p) {
    p.style.display = 'none';
  });
  /* Deactivate all tabs */
  document.querySelectorAll('.pragya-past-tab').forEach(function(t) {
    t.classList.remove('active');
  });
  /* Show selected */
  document.getElementById('pragya-past-' + id).style.display = 'block';
  btn.classList.add('active');
}

/* ── CAROUSEL ── */
var pragyaCarouselIndex = {};

function pragyaCarouselMove(id, dir) {
  var track  = document.getElementById('track-' + id);
  var slides = track.querySelectorAll('.pragya-carousel-slide');
  var total  = slides.length;
  if (!pragyaCarouselIndex[id]) pragyaCarouselIndex[id] = 0;
  pragyaCarouselIndex[id] = (pragyaCarouselIndex[id] + dir + total) % total;
  pragyaCarouselUpdate(id);
}

function pragyaCarouselGoTo(id, index) {
  pragyaCarouselIndex[id] = index;
  pragyaCarouselUpdate(id);
}

function pragyaCarouselUpdate(id) {
  var index  = pragyaCarouselIndex[id] || 0;
  var track  = document.getElementById('track-' + id);
  var slides = track.querySelectorAll('.pragya-carousel-slide');
  var slideW = slides[0] ? slides[0].offsetWidth + 16 : 0;
  track.style.transform = 'translateX(-' + (index * slideW) + 'px)';
  /* Update dots */
  var dots = document.querySelectorAll('#dots-' + id + ' .pragya-carousel-dot');
  dots.forEach(function(d, i) {
    d.classList.toggle('active', i === index);
  });
}

/* Recalc on resize */
window.addEventListener('resize', function() {
  Object.keys(pragyaCarouselIndex).forEach(function(id) {
    pragyaCarouselUpdate(id);
  });
});

/* ── LIGHTBOX ── */
function pragyaLightbox(img, heading, desc) {
  var lb  = document.getElementById('pragya-lightbox');
  var lbi = document.getElementById('pragya-lightbox-img');
  var lbc = document.getElementById('pragya-lightbox-caption');
  lbi.src = img.src;
  if (lbc) {
    lbc.innerHTML =
      (heading ? '<strong>' + heading + '</strong>' : '') +
      (desc    ? '<p>' + desc + '</p>' : '');
    lbc.style.display = (heading || desc) ? 'block' : 'none';
  }
  lb.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function pragyaCloseLightbox() {
  document.getElementById('pragya-lightbox').style.display = 'none';
  document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    pragyaCloseLightbox();
    /* Also close event modal if open */
    var scrollY = parseInt(document.body.dataset.scrollY || '0');
    document.querySelectorAll('.pragya-modal').forEach(function(m) {
      m.style.display = 'none';
    });
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.width = '';
    window.scrollTo(0, scrollY);
  }
});
</script>

